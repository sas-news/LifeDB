LIFEDB_VAULT=./vault
LIFEDB_BIND=127.0.0.1
LIFEDB_PORT=7331
LIFEDB_UID=1000
LIFEDB_GID=1000
# Optional for local health-only use; when set, use at least 32 random UTF-8
# bytes and no whitespace (maximum 4096 UTF-8 bytes).
LIFEDB_API_TOKEN=
LIFEDB_SENSITIVITY_CEILING=personal
LIFEDB_INGEST_SENSITIVITY_FLOOR=personal
