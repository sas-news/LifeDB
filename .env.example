# The approved wrapper reads this file without shell evaluation. Process
# environment values take precedence over these assignments.
# Absolute, existing host path. Keep the vault outside this repository.
LIFEDB_VAULT=/home/your-user/.local/share/lifedb/vault
LIFEDB_BIND=127.0.0.1
LIFEDB_PORT=7331
LIFEDB_UID=1000
LIFEDB_GID=1000
# Absolute, existing host path to a regular file owned by the serving user,
# with mode 0600 and one newline-free token of 32-4096 UTF-8 bytes.
# The wrapper requires exact host mode 0600; src/lifedb/auth.py also accepts
# owner-only 0400 for non-Compose callers.
LIFEDB_API_TOKEN_FILE=/home/your-user/.config/lifedb/api-token
LIFEDB_SENSITIVITY_CEILING=personal
LIFEDB_INGEST_SENSITIVITY_FLOOR=personal

# Production Compose commands must use the host preflight wrapper. It loads this
# repository .env, rejects relative paths, validates the vault/token before
# Docker resolves mounts, and pins the owned compose.yaml/project directory:
# python scripts/lifedb-compose.py up -d --build
# Wrapper -f/--file, --env-file, --project-directory, COMPOSE_FILE, and
# COMPOSE_ENV_FILES overrides are rejected. Raw `docker compose` bypasses these
# host checks and is not approved for production.
